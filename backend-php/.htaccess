# Apache / LiteSpeed Rewrite Configuration for Hostinger PHP API
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Enable Authorization header forwarding for Bearer tokens
  RewriteCond %{HTTP:Authorization} .
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

  # If the request is for an existing file or directory, serve directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Route all API endpoint requests to index.php
  RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

# Prevent directory listing
Options -Indexes

# Security: Block direct browser access to SQLite database files
<FilesMatch "\.(sqlite|db)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>
